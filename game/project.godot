; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tide & Trove"
config/description="Dig, prepare and display prehistoric wonders to save Ammonite Bay."
config/version="1.0.0-prealpha"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07, 0.24, 0.29, 1)
boot_splash/image="res://assets/branding/boot_splash.png"
config/icon="res://assets/branding/icon_256.png"
config/windows_native_icon="res://assets/branding/icon.ico"
boot_splash/fullsize=false

[autoload]

DB="*res://scripts/autoload/db.gd"
Events="*res://scripts/autoload/events.gd"
Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Audio="*res://scripts/autoload/audio.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
GodotMCPRuntimeProbe="*uid://dot7tp860k3nj"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_bridge/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="actors"
3d_physics/layer_4="interact"
3d_physics/layer_5="ragdoll"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
